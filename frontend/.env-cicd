# Build-time environment for the Docker image (copied to .env.local by the Dockerfile).
# *_PLACEHOLDER values are replaced by entrypoint.sh at container start from the real environment,
# so the same image can be deployed to every environment. Every placeholder here must also be listed
# in entrypoint.sh.
#
# Comparisons on these values must go through src/utils/runtime-env.ts, otherwise the minifier
# evaluates them against the placeholder at build time.
#
# NEXT_PUBLIC_BASE_PATH is baked into the routing at build time and cannot be a placeholder.
# HEALTH_* and INTERNAL_API_URL are server-only and read from the container environment at runtime.

NEXT_PUBLIC_BASE_PATH=
HEALTH_AUTH=false
HEALTH_USERNAME=
HEALTH_PASSWORD=

# --- App ---
NEXT_PUBLIC_API_URL=NEXT_PUBLIC_API_URL_PLACEHOLDER
NEXT_PUBLIC_APP_NAME=NEXT_PUBLIC_APP_NAME_PLACEHOLDER
NEXT_PUBLIC_DELEGATE_CHANNEL=NEXT_PUBLIC_DELEGATE_CHANNEL_PLACEHOLDER
NEXT_PUBLIC_INACTIVITY_WARNING_TIMEOUT=NEXT_PUBLIC_INACTIVITY_WARNING_TIMEOUT_PLACEHOLDER
NEXT_PUBLIC_INACTIVITY_COUNTDOWN_TIMEOUT=NEXT_PUBLIC_INACTIVITY_COUNTDOWN_TIMEOUT_PLACEHOLDER

# --- Feature flags ("true" to enable) ---
NEXT_PUBLIC_FEATURE_AI_ASSISTANT=NEXT_PUBLIC_FEATURE_AI_ASSISTANT_PLACEHOLDER
NEXT_PUBLIC_FEATURE_DISTURBANCES=NEXT_PUBLIC_FEATURE_DISTURBANCES_PLACEHOLDER

# --- Alert banner (optional) ---
NEXT_PUBLIC_ALERT_BANNER_MESSAGE=NEXT_PUBLIC_ALERT_BANNER_MESSAGE_PLACEHOLDER
NEXT_PUBLIC_ALERT_BANNER_SEVERITY=NEXT_PUBLIC_ALERT_BANNER_SEVERITY_PLACEHOLDER

# --- Matomo (optional) ---
NEXT_PUBLIC_MATOMO_URL=NEXT_PUBLIC_MATOMO_URL_PLACEHOLDER
NEXT_PUBLIC_MATOMO_SITE_ID=NEXT_PUBLIC_MATOMO_SITE_ID_PLACEHOLDER
