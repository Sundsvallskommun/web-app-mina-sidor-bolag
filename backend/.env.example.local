# PORT
PORT=3001
# Base prefix to be added to all end-points
BASE_URL_PREFIX=/api
# Sundsvalls kommun API end-point
API_BASE_URL=https://api-test.sundsvall.se
# Credentials used for API
CLIENT_KEY={{INSERT CLIENT_KEY}}
CLIENT_SECRET={{INSERT CLIENT SECRET}}
FEEDBACK_EMAIL={{SET_FEEDBACK_EMAIL}}

MUNICIPALITY_ID=2281
NAMESPACE=minasidorbolagen

# ENEO settings
ENEO_API_KEY=

# SAML
# Backend URLs - full URLS
SAML_CALLBACK_URL=http://localhost:3001/api/saml/login/callback
SAML_LOGOUT_CALLBACK_URL=http://localhost:3001/api/saml/logout/callback
SAML_FAILURE_REDIRECT=http://localhost:3001/api/saml/login
# Redirects to frontend (if url provided in RelayState is not valid)
SAML_SUCCESS_REDIRECT=http://localhost:3000/valj-foretag
SAML_LOGOUT_REDIRECT=http://localhost:3000/

SAML_LOGOUT_URL=http://{{domain-to-sso}}/logout
SAML_ENTRY_SSO=http://{{domain-to-sso}}/sso
SAML_IDP_PUBLIC_CERT="-----BEGIN CERTIFICATE-----\n{{INSERT_CERT}}\n-----END CERTIFICATE-----\n"

SAML_ISSUER=passport-saml
SAML_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n{{INSERT_KEY}}\n-----END PRIVATE KEY-----\n"
SAML_PUBLIC_KEY="-----BEGIN CERTIFICATE-----\n{{INSERT_KEY}}\n-----END CERTIFICATE-----\n"

# SAML - internal admin IdP (separate login flow under /saml/admin)
SAML_ADMIN_CALLBACK_URL=http://localhost:3001/api/saml/admin/login/callback
SAML_ADMIN_LOGOUT_CALLBACK_URL=http://localhost:3001/api/saml/admin/logout/callback
SAML_ADMIN_FAILURE_REDIRECT=http://localhost:3001/api/saml/admin/login
# Redirects to frontend (if url provided in RelayState is not valid)
SAML_ADMIN_SUCCESS_REDIRECT=http://localhost:3000/admin
SAML_ADMIN_LOGOUT_REDIRECT=http://localhost:3000/

SAML_ADMIN_LOGOUT_URL=http://{{admin-domain-to-sso}}/logout
SAML_ADMIN_ENTRY_SSO=http://{{admin-domain-to-sso}}/sso
SAML_ADMIN_IDP_PUBLIC_CERT="-----BEGIN CERTIFICATE-----\n{{INSERT_ADMIN_CERT}}\n-----END CERTIFICATE-----\n"

SAML_ADMIN_ISSUER=passport-saml-admin
SAML_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n{{INSERT_ADMIN_KEY}}\n-----END PRIVATE KEY-----\n"
SAML_ADMIN_PUBLIC_KEY="-----BEGIN CERTIFICATE-----\n{{INSERT_ADMIN_KEY}}\n-----END CERTIFICATE-----\n"

# Used for encryption
SECRET_KEY="{{INSERT_RANDOM_STRING}}"

# Environment (optional)
ENVIRONMENT="TEST"

# Environment dependent mock data (optional, only used when ENVIRONMENT==="TEST")
MOCK_ORGANIZATION_NAME=""
MOCK_ORGANIZATION_NUMBER=""

# CGI GRP (Signering)
GRP_URL=https://eid-connect.test.funktionstjanster.se/grp/v3
GRP_DISPLAY_NAME=
GRP_SERVICE_ID=
GRP_ACCESS_TOKEN=
GRP_DEV_PERSONNUMBER=

# Swagger
SWAGGER_ENABLED=true

# LOG - for prod use "combined" LOG_FORMAT
LOG_FORMAT=dev
LOG_DIR=../../data/logs

# CORS & REDIRECTS
ORIGIN=http://localhost:3000
CREDENTIALS=true

# BFUS settings & credentials
BFUS_EXTERNAL_ID=example
BFUS_API_KEY=""

# Group considered admins
ADMIN_GROUP=""

# Whitelisted organizations
WHITELISTED_ORGS=""
