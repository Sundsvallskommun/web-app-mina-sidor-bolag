# Test environment. Committed on purpose: these are placeholders, not secrets.
# jest forces NODE_ENV=test, so without this file there is no env at all and every
# suite that imports @config fails at import time.
#
# This file is in a public repository. Never copy a value here from
# .env.development.local - put real values in that file, which is gitignored.
#
# GRP_DEV_PERSONNUMBER is deliberately absent: it holds a personnummer and is only
# read when a BankID signing is actually initiated, which no test does.

NODE_ENV=test
PORT=3000
BASE_URL_PREFIX=/api
LOG_FORMAT=dev
LOG_DIR=../../data/logs

SECRET_KEY=test-secret-key
API_BASE_URL=http://localhost:9999
CLIENT_KEY=test-client-key
CLIENT_SECRET=test-client-secret

ORIGIN=http://localhost:3000
CREDENTIALS=true
SESSION_MEMORY=true
SWAGGER_ENABLED=false

MUNICIPALITY_ID=2281
MUNICIPALITY_ORG_NR=2120002411
NAMESPACE=minasidorbolagen
ENVIRONMENT=TEST
ADMIN_GROUP=test-admins
WHITELISTED_ORGS=

FEEDBACK_EMAIL=test@example.com
ENEO_API_KEY=test-eneo-key
BFUS_EXTERNAL_ID=test-bfus
BFUS_API_KEY=test-bfus-key

GRP_URL=http://localhost:9999
GRP_SERVICE_ID=test-service
GRP_ACCESS_TOKEN=test-token
GRP_DISPLAY_NAME=Test

ELOMRADEN_API_USER=test-user
ELOMRADEN_API_KEY=test-key

# SAML. The strategy only checks these are present, so placeholders are enough.
SAML_CALLBACK_URL=http://localhost:3000/api/saml/login/callback
SAML_LOGOUT_URL=http://localhost:3000/api/saml/logout
SAML_LOGOUT_CALLBACK_URL=http://localhost:3000/api/saml/logout/callback
SAML_LOGOUT_REDIRECT=http://localhost:3000
SAML_FAILURE_REDIRECT=http://localhost:3000
SAML_SUCCESS_REDIRECT=http://localhost:3000
SAML_ENTRY_SSO=http://localhost:9999/sso
SAML_ISSUER=test-issuer
SAML_IDP_PUBLIC_CERT=test-idp-cert
SAML_PRIVATE_KEY=test-private-key
SAML_PUBLIC_KEY=test-public-key

SAML_ADMIN_CALLBACK_URL=http://localhost:3000/api/saml/admin/login/callback
SAML_ADMIN_LOGOUT_URL=http://localhost:3000/api/saml/admin/logout
SAML_ADMIN_LOGOUT_CALLBACK_URL=http://localhost:3000/api/saml/admin/logout/callback
SAML_ADMIN_LOGOUT_REDIRECT=http://localhost:3000
SAML_ADMIN_FAILURE_REDIRECT=http://localhost:3000
SAML_ADMIN_SUCCESS_REDIRECT=http://localhost:3000
SAML_ADMIN_ENTRY_SSO=http://localhost:9999/sso
SAML_ADMIN_ISSUER=test-admin-issuer
SAML_ADMIN_IDP_PUBLIC_CERT=test-idp-cert
SAML_ADMIN_PRIVATE_KEY=test-private-key
SAML_ADMIN_PUBLIC_KEY=test-public-key
